{
  "name": "pocketdesk-android",
  "version": "0.9.0",
  "private": true,
  "description": "PocketDesk Android Application - Dedicated Mobile Interface for Windows Laptop Remote Access",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "test": "tsc --outDir build/test-out --module commonjs --target es2022 --noEmit false && node --test build/test-out/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.11",
    "@types/react-native": "^0.72.8",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  }
}
